# macOS
.DS_Store

# Xcode project is generated by XcodeGen from project.yml
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Xcode user state and build output
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM
*.xcarchive
*.hmap
*.moved-aside
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# Secrets (admin PIN, signing) — never commit
Secrets.xcconfig
Secrets.xconfig
Signing.xcconfig
*.p12
*.mobileprovision
*.cer
AuthKey_*.p8
.env

# Local tools output
tools/*.log
tools/received*.csv
__pycache__/
